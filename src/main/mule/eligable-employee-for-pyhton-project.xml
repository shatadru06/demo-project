<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd">
	<salesforce:sfdc-config name="Salesforce_Config" doc:name="Salesforce Config" doc:id="cf457915-efc3-4f6c-9fb1-7b7aed80ccf6" >
		<salesforce:basic-connection username="shatadru.mandal783@agentforce.com" password="Shatadru@123" securityToken="LT0cEVgJrT6FPXwHnHEFopCi" />
	</salesforce:sfdc-config>
	<flow name="eligable-employee-for-pyhton-projectFlow" doc:id="69ed454e-c80e-48f3-9bc6-f51fbeeb0a3e" >
		<http:listener doc:name="Listener" doc:id="bc422139-4697-4b8a-9e93-b269e1dd8326" config-ref="HTTP_Listener_config" path="/python/{empId}"/>
		<logger level="INFO" doc:name="Logger" doc:id="55ef9eaa-dda5-4891-98e9-ed0c5542a4e8" message='#["The employee id is:"++ attributes.uriParams.empId]'/>
		<set-variable value="#[attributes.uriParams.empId]" doc:name="Set Variable" doc:id="524d98cc-81b5-42cb-8602-bb97612bc2d1" variableName="employeeId"/>
		<salesforce:query doc:name="Query" doc:id="050a4b04-83f0-415b-afee-92162f4e96d5" config-ref="Salesforce_Config">
			<salesforce:salesforce-query ><![CDATA[SELECT 	id, employeeID__c, Name, emp_skills__c, emp_phone__c, emp_email__c, LastModifiedDate FROM Employee_Profile__c WHERE emp_skills__c = 'python' AND employeeId__c = ':empId'

]]></salesforce:salesforce-query>
			<salesforce:parameters ><![CDATA[#[output application/java
---
{
	empId : vars.employeeId
}]]]></salesforce:parameters>
		</salesforce:query>
		<logger level="INFO" doc:name="Logger" doc:id="98cff88d-c39c-436d-8b24-58b1ee1873cd" message="#[%dw 2.0&#10;output application/json&#10;---&#10;payload]"/>
		<choice doc:name="Choice" doc:id="e27ab62a-5588-48d9-a3dd-1fb22ae9dace" >
			<when expression="#[!isEmpty(payload)]">
				<set-payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	"name": payload[0].Name,&#10;	"employee_id": payload[0].employeeID__c,&#10;	"email_id": payload[0].emp_email__c,&#10;	"phone": payload[0].emp_phone__c&#10;}]' doc:name="Set Payload" doc:id="983146c0-32ea-4fc1-953a-f9e28ec1fc2b" />
			</when>
			<otherwise >
				<set-payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	"message": "This employee is not appropriate for a python project"&#10;}]' doc:name="Set Payload" doc:id="427e0f22-f799-45b7-bc99-dfec36db4783" />
			</otherwise>
		</choice>
	</flow>
</mule>
